# Environment variables — copy to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets (.gitignore
# already excludes .env* except this .example file).

# --- Site ---
# Canonical origin, used for metadata/OG tag generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Figma (Code Connect sync — see figma.config.json) ---
# Personal access token with Code Connect write scope, from
# Figma > Settings > Personal access tokens. Only needed when running
# `figma connect publish`, not for local development.
FIGMA_ACCESS_TOKEN=

# --- Resend (contact form — see src/app/api/contact/route.ts) ---
# API key from https://resend.com/api-keys. Required for the contact form
# to actually send; without it the form returns a clear error instead of
# silently failing.
RESEND_API_KEY=

# Sender address for outgoing contact-form emails. Until a domain is
# verified in Resend, sending is sandboxed: you can only send FROM
# onboarding@resend.dev (the default if this is left blank), and only TO
# the email address your Resend account was signed up with — so testing
# only works if profile.email (src/lib/content/profile.ts) matches that
# account email. Once a domain is verified in the Resend dashboard, set
# this to a real address on it (e.g. "Portfolio <contact@yourdomain.com>")
# to send to any recipient.
CONTACT_FROM_EMAIL=

# --- Supabase (admin CMS — see supabase/schema.sql, src/lib/supabase/*) ---
# From Project Settings → API in your Supabase dashboard. Run
# supabase/schema.sql in the SQL Editor once, first.
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (new projects) — the same thing older dashboards call
# the "anon" / "anon public" key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (new projects) — the same thing older dashboards call the
# "service_role" key. Bypasses Row Level Security entirely — server-side
# only, never expose to the browser, never commit.
SUPABASE_SECRET_KEY=

# The only email allowed to sign in to /admin. Magic-link sign-in checks
# this server-side after auth, regardless of who else might have a
# Supabase account on this project.
ADMIN_EMAIL=
